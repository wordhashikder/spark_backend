# PickASparky API configuration.
# Copy to `.env` for local development. In production set these as environment
# variables in Coolify (never commit real values).

# --- Core ---------------------------------------------------------------------
# development | production | test
ENVIRONMENT=development
DEBUG=false
# Signs access tokens and review links. Generate with: openssl rand -hex 32
# Must be at least 32 characters when ENVIRONMENT=production.
SECRET_KEY=change-me
# postgresql://, postgres:// and postgresql+asyncpg:// are all accepted.
DATABASE_URL=postgresql://pickasparky:pickasparky@localhost:5432/pickasparky
# Public URL of the Next.js site (used for links in emails and Stripe return URLs).
FRONTEND_URL=http://localhost:3000
# Public URL of the Dashboard app (installer and admin back office), used in email links.
DASHBOARD_URL=http://localhost:5173
# Browser origins allowed to call the API directly (comma separated). The public
# site calls the API server-side; the Dashboard app calls it from the browser, so its
# origin must be listed here (e.g. https://dashboard.pickasparky.co.uk).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Hostnames the API answers to (comma separated). `*` allows any (development only).
ALLOWED_HOSTS=*
# Shared secret with the frontend (its INTERNAL_API_KEY must match). It lets the API
# trust the visitor IP the frontend forwards, so rate limits apply per visitor.
# Required in production. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=dev-internal-key
# Where the API reaches the website to refresh its cached pages after an edit in the
# Dashboard (POST /api/revalidate/, authenticated with INTERNAL_API_KEY). Blank = FRONTEND_URL;
# set it when the API reaches the website on a private address (e.g. http://frontend:3000).
FRONTEND_INTERNAL_URL=
# Interactive API docs at /docs. Blank = on in development, off in production.
DOCS_ENABLED=

# --- Sessions -----------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# The Dashboard's refresh token is an httpOnly cookie set by this API. "lax" works when
# the Dashboard and API share a site (dashboard.pickasparky.co.uk + api.pickasparky.co.uk,
# or localhost in development). Use "none" only for unrelated domains (needs HTTPS).
SESSION_COOKIE_SAMESITE=lax
# Optional cookie domain; blank = the API host only (recommended).
SESSION_COOKIE_DOMAIN=

# --- Email (SMTP) -------------------------------------------------------------
# Leave SMTP_HOST blank in development: nothing is sent. Each email is written to the API
# log AND saved as an HTML file in backend/dev-outbox/ (open it in a browser and click its
# buttons, e.g. "View My Quotes"). To receive real emails, e.g. at a temp-mail inbox, fill in
# any SMTP provider: Brevo (smtp-relay.brevo.com:587), Mailtrap (sandbox.smtp.mailtrap.io:587),
# Gmail (smtp.gmail.com:587 with an app password), Amazon SES, Postmark, Resend...
# Restart the API afterwards. Production requires it (and a verified sending domain).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Use STARTTLS on port 587 (default), or implicit TLS on port 465. Not both:
#   port 587 -> SMTP_START_TLS=true  SMTP_USE_TLS=false
#   port 465 -> SMTP_START_TLS=false SMTP_USE_TLS=true
# Hostinger mailbox (e.g. notifications@pickasparky.com): SMTP_HOST=smtp.hostinger.com, port
# 465 with TLS on, and the mailbox address as SMTP_USERNAME. Quote a password that contains
# $ # or spaces with single quotes: SMTP_PASSWORD='...'.
SMTP_START_TLS=true
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@pickasparky.co.uk
EMAIL_FROM_NAME=PickASparky
# Receives contact-form messages and unmatched-quote alerts.
SUPPORT_EMAIL=hello@pickasparky.co.uk

# --- Cloudinary (installer logos and gallery photos) ---------------------------
# Blank = uploads return 503 service_not_configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pickasparky

# --- Stripe (paid memberships) --------------------------------------------------
# Blank secret key = billing endpoints return 503 service_not_configured.
# Plans and prices are NOT configured here: manage them in the Dashboard (Plans & billing).
# They are created in Stripe automatically from there.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint https://<api-host>/api/v1/billing/webhook.
# Without it plans still work, but renewals and payment failures cannot be received.
STRIPE_WEBHOOK_SECRET=

# --- Misc ---------------------------------------------------------------------
# memory:// for a single instance; redis://host:6379 when running several.
RATE_LIMIT_STORAGE_URI=memory://
POSTCODES_API_URL=https://api.postcodes.io
# How many installers a quote request is sent to.
MAX_QUOTE_MATCHES=5
# Showcase installers and reviews from the original design (app/data/demo.json).
# They are fictional, so they are never added in production unless this is true:
# publishing invented reviews to consumers is unlawful in the UK (DMCC Act 2024).
# Use only on a staging site that the public cannot reach. Read by `seed-content`.
SEED_SHOWCASE=false
