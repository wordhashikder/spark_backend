  "reviews": [
    {"installer": "GreenCharge Electrical", "rating": 5, "days_ago": 3, "title": "Great service from start to finish", "body": "The team were punctual, tidy and explained everything clearly. The charger was installed in a morning and has worked perfectly ever since.", "author_name": "Steve M.", "author_location": "Manchester"},
    {"installer": "GreenCharge Electrical", "rating": 5, "days_ago": 9, "title": "Highly recommend", "body": "Quick quote, fair price and a very neat installation on the side of the house. They even helped set up the charging schedule in the app.", "author_name": "Sarah T.", "author_location": "Stockport"},
    {"installer": "GreenCharge Electrical", "rating": 4, "days_ago": 20, "title": "Professional and reliable", "body": "Turned up when they said they would and did a good job. The cable run was longer than expected but they handled it without any fuss.", "author_name": "James P.", "author_location": "Salford"},
    {"installer": "VoltWise Electrical", "rating": 5, "days_ago": 5, "title": "Found the right installer", "body": "I had no idea which charger to choose. VoltWise talked me through the options and fitted it within the week. Very happy.", "author_name": "Emma L.", "author_location": "Manchester"},
    {"installer": "VoltWise Electrical", "rating": 4, "days_ago": 27, "title": "Good job, fair price", "body": "Straightforward installation and a competitive quote. Communication was good throughout and they left everything clean.", "author_name": "Daniel K.", "author_location": "Trafford"},
    {"installer": "ChargeRight Solutions", "rating": 5, "days_ago": 7, "title": "Saved me time and hassle", "body": "I got three quotes through PickASparky and ChargeRight were the most helpful. The whole thing was sorted in a few days.", "author_name": "Olivia R.", "author_location": "Salford"},
    {"installer": "ChargeRight Solutions", "rating": 5, "days_ago": 31, "title": "Excellent workplace install", "body": "They installed two chargers at our office with minimal disruption. Everything was certified and explained to our staff.", "author_name": "Mark D.", "author_location": "Bolton"},
    {"installer": "North West EV", "rating": 5, "days_ago": 12, "title": "Friendly and knowledgeable", "body": "Really pleased with the service. They recommended a charger that suited our tariff and fitted it neatly in the garage.", "author_name": "Hannah B.", "author_location": "Stockport"},
    {"installer": "EcoWatt Installations", "rating": 4, "days_ago": 16, "title": "Solar and charger together", "body": "EcoWatt linked our new charger to the solar panels so the car charges from the sun when it can. Works well.", "author_name": "Paul W.", "author_location": "Altrincham"},
    {"installer": "GreenCharge Experts", "rating": 5, "days_ago": 22, "title": "Brilliant from quote to finish", "body": "Clear pricing, no hidden extras and a very tidy job. I would happily use them again and have already recommended them.", "author_name": "Laura S.", "author_location": "Liverpool"},
    {"installer": "AmpFlow Electric", "rating": 5, "days_ago": 14, "title": "Top quality work", "body": "A proper professional outfit. They upgraded part of the consumer unit as well and everything was fully tested.", "author_name": "Tom H.", "author_location": "Leeds"},
    {"installer": "PowerGrid Installers", "rating": 4, "days_ago": 35, "title": "Smooth installation", "body": "Booked in quickly and the installer was polite and efficient. Charger works as expected and looks neat on the wall.", "author_name": "Rebecca N.", "author_location": "York"}
  ]
